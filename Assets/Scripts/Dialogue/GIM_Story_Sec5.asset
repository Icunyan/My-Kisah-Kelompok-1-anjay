%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 453557b4d2017fc45acd9fc4662e9ee1, type: 3}
  m_Name: GIM_Story_Sec5
  m_EditorClassIdentifier: 
  characterName: 
  characterID: 
  dialogueLines: []
  lines:
  - speakerName: Ren
    speakerID: REN
    customPortrait: {fileID: 0}
    text: Lara?!
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: L
    emotionIndex: 0
  - speakerName: Marco
    speakerID: MARCO
    customPortrait: {fileID: 0}
    text: Ada apa dengannya?! Lara! Sial, dia pasti benar-benar kehabisan energi
      sihirnya karena memaksakan diri sejak tadi!
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: R
    emotionIndex: 0
  - speakerName: Narasi
    speakerID: NARASI
    customPortrait: {fileID: 0}
    text: (Tiba-tiba, pintu aula panti asuhan terbuka lebar. Derap langkah kaki yang
      tergesa-gesa terdengar mendekat, disusul oleh sebuah suara yang sangat familier
      bagi Ren.)
    customBackground: {fileID: 0}
    animationTrigger: 
    characterPosition: None
    emotionIndex: 0
  - speakerName: Lucia
    speakerID: LUCIA
    customPortrait: {fileID: 21300000, guid: ad22100648446e741aab6bc13bba3df3, type: 3}
    text: Ren! Akhirnya aku menemukanmu! Kenapa kau hobi sekali pergi duluan tanpa
      menunggu, sih?!
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: jump
    characterPosition: R
    emotionIndex: 0
  - speakerName: Ren
    speakerID: REN
    customPortrait: {fileID: 0}
    text: Lu... Lucia?! Kenapa kau bisa ada di sini? Kau menyusulku dari akademi?
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: L
    emotionIndex: 0
  - speakerName: Lucia
    speakerID: LUCIA
    customPortrait: {fileID: 21300000, guid: 36bf06e3419993a4b923fd6f20ae3bac, type: 3}
    text: Tentu saja! Berita serangan pasukan iblis ini sudah menyebar luas, aku
      tidak mungkin membiarkanmu menghadapi ini sendirian!
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: R
    emotionIndex: 0
  - speakerName: Ren
    speakerID: REN
    customPortrait: {fileID: 0}
    text: Lucia, kamu datang di waktu yang tepat! Kau jauh lebih jago sihir penyembuhan
      tingkat tinggi daripadaku. Periksa keadaan Lara!
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: L
    emotionIndex: 0
  - speakerName: Lucia
    speakerID: LUCIA
    customPortrait: {fileID: 21300000, guid: 4f5409fd981e0224984030caeb9f1a76, type: 3}
    text: ' ...Tunggu. Jadi, dia ini... Lara? Teman masa kecil yang selalu, selalu
      kau ceritakan di akademi itu?'
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: R
    emotionIndex: 0
  - speakerName: Ren
    speakerID: REN
    customPortrait: {fileID: 0}
    text: Iya! Kumohon, Lucia, nanti saja tanyanya. Dia pingsan karena kehabisan
      mana!
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: jump
    characterPosition: L
    emotionIndex: 0
  - speakerName: Lucia
    speakerID: LUCIA
    customPortrait: {fileID: 21300000, guid: 091bc4b6901a3a8459e334f98746119f, type: 3}
    text: Huh... jadi ini orangnya. Baiklah, baiklah! Minggir sedikit, biar kuperiksa.
      Jauh-jauh aku menyusulmu ke sini, malah langsung disuruh mengobati saingan...
      maksudku, temanmu!
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: R
    emotionIndex: 0
  - speakerName: Narasi
    speakerID: NARASI
    customPortrait: {fileID: 0}
    text: Cahaya hijau dari sihir penyembuhan Lucia perlahan meredup, raut wajahnya
      berubah menjadi semakin serius setelah memeriksa aliran mana di tubuh Lara.
      Ren dan Marco menunggu dengan cemas
    customBackground: {fileID: 0}
    animationTrigger: flash
    characterPosition: None
    emotionIndex: 0
  hasChoices: 0
  choices: []
  nextDialogue: {fileID: 11400000, guid: 917f9369bbb6ce3449061d11cbc6f31a, type: 2}
  actionID: 
  isCutscene: 1
