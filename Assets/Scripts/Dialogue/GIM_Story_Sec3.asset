  characterName: 
  characterID: 
  dialogueLines: []
  lines:
  - speakerName: Marco
    speakerID: MARCO
    customPortrait: {fileID: 0}
    text: Lara! Kau memaksakan dirimu lagi? Istirahatlah dulu, pasokan medisnya sudah
      datang.
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: R
    emotionIndex: 0
  - speakerName: Lara
    speakerID: LARA
    customPortrait: {fileID: 0}
    text: "Aku tidak apa-apa, Marco... warga masih banyak yang\u2014"
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: 
    characterPosition: C
    emotionIndex: 0
  - speakerName: Lara
    speakerID: LARA
    customPortrait: {fileID: 0}
    text: ...Ren? Ini... benar-benar kau?
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: jump
    characterPosition: C
    emotionIndex: 0
  - speakerName: Ren
    speakerID: REN
    customPortrait: {fileID: 0}
    text: Lara Maaf aku terlambat. Jangan paksakan sihirmu lagi, biar aku yang bantu
      sisa warga di sini.
    customBackground: {fileID: 21300000, guid: ee4c84f8c4445c443861bbf407ad007b, type: 3}
    animationTrigger: jump
    characterPosition: L
    emotionIndex: 0
